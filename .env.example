# polybrain-kernel — example env
# Copy to .env and fill in your own keys.
# .env is git-ignored. Rotate keys regularly.

# Channel A: self-pool (OpenAI, xAI, Groq, Moonshot-via-Groq)
OPENAI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=

# Channel B: disjoint-transformer pool (Anthropic, Google, DeepSeek, Mistral, Cohere, Alibaba)
POLYBRAIN_ANTHROPIC_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
DASHSCOPE_API_KEY=

# Optional: follow-up deposit (only needed if you run src/experiment/run.mjs
# and want to mint a replay deposit on Zenodo afterward)
ZENODO_TOKEN=
