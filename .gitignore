node_modules/
.DS_Store
*.log

# Canon defaults to gitignored (user-owned / local-only), with specific
# allowlisted files that DO ship with the repo.
# - rcc-n30-2026-04-14.jsonl: frozen v1.0.0-experiment scientific record
# - default.jsonl: the running daemon's canon. The Kernel Daemon
#   workflow writes to it every 6h and commits the delta back. Without
#   this exception, every daemon run starts from empty canon and the
#   Scientists workflow can't see any findings because its checkout
#   has no canon file. Fixed 2026-04-17 after user report "[CRITICAL]
#   canon/default.jsonl not found" — the substrate was throwing away
#   the daemon's output between workflow invocations.
canon/*.jsonl
!canon/.gitkeep
!canon/rcc-n30-2026-04-14.jsonl
!canon/default.jsonl

# State files are transient (progress is tracked separately)
state/*.json
!state/progress.json
!state/daemon-progress.json
!state/.gitkeep

# Environment files never committed
.env
.env.*
!.env.example

# Build artifacts
dist/
build/
*.tmp
